# Upstash Redis (Vercel Marketplace injects these, possibly as KV_REST_API_URL / KV_REST_API_TOKEN, both work)
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob uses OIDC: the store id is injected by Vercel when you connect a Blob store, and
# VERCEL_OIDC_TOKEN comes from `vercel env pull` locally. No read-write token is needed.
BLOB_STORE_ID=

# Random string (>= 32 chars) used to sign room tokens. Generate: openssl rand -base64 48
ROOM_TOKEN_SECRET=change-me-to-a-long-random-string

# Random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=change-me-too
